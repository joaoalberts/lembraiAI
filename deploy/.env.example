# Modelo do deploy/.env. Não preencha na mão: `scripts/gen-env.sh <host>` cria o .env com segredos aleatórios.
# O .env real fica só na VPS (permissão 600) e NUNCA vai para o git. Faça backup dele: sem o JWT_SECRET e a senha do banco, o backup do banco não serve.

# Endereço público (sem https://). O app, o site e a API respondem todos nele.
PUBLIC_HOST=lembreiai.exemplo.com
SITE_URL=https://lembreiai.exemplo.com
URI_ALLOW_LIST=

POSTGRES_PASSWORD=gerado-por-gen-env
JWT_SECRET=gerado-por-gen-env
# JWT com role=anon assinado com o JWT_SECRET. É a "chave publicável" do app (EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY) e pode ficar no app.
ANON_KEY=gerado-por-gen-env

# E-mail (recuperação de senha por código). Sem SMTP: MAILER_AUTOCONFIRM=true e o "esqueci minha senha" não envia nada.
# Com SMTP (Gmail com senha de app, caixa da Hostinger, Brevo...), preencha e ponha MAILER_AUTOCONFIRM=false.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=LembreiAi
RATE_LIMIT_EMAIL_SENT=30

# Só para docker-compose.traefik.yml (VPS que já tem Traefik). Descubra com `docker inspect <contêiner-do-traefik>`.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=

# Só para docker-compose.caddy.yml em testes locais (em produção deixe os padrões 80/443).
# GATEWAY_HTTP_PORT=8088
# GATEWAY_HTTPS_PORT=8443
