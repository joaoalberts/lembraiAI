# O supabase-js do app chama <URL>/auth/v1/* (login) e <URL>/rest/v1/* (dados); o resto é o site.
{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle {
		reverse_proxy web:80
	}
}
