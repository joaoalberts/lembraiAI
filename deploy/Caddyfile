# O supabase-js do app chama <URL>/auth/v1/* (login) e <URL>/rest/v1/* (dados); o resto é o site.
{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Auth API
	handle_path /auth/v1/* {
		@options {
			method OPTIONS
		}
		respond @options 204

		reverse_proxy auth:9999 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			header_down Access-Control-Allow-Headers "Content-Type, Authorization, apikey, X-Client-Info, X-Supabase-API-Version, x-retry-count, accept-profile, content-profile, prefer"
		}
	}

	# REST API
	handle_path /rest/v1/* {
		@options {
			method OPTIONS
		}
		respond @options 204

		reverse_proxy rest:3000 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			header_down Access-Control-Allow-Headers "Content-Type, Authorization, apikey, X-Client-Info, X-Supabase-API-Version, x-retry-count, accept-profile, content-profile, prefer"
			header_down Access-Control-Expose-Headers "Content-Range"
		}
	}

	# Web UI
	handle {
		reverse_proxy web:80
	}
}
