# O supabase-js do app chama <URL>/auth/v1/* (login) e <URL>/rest/v1/* (dados); o resto é o site.
{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, apikey, X-Client-Info, X-Supabase-API-Version, x-retry-count, accept-profile, content-profile, prefer"
		# os três últimos vêm do GoTrue: a regra global sobrescreveria a dele e o app deixaria de lê-los
		Access-Control-Expose-Headers "Content-Range, X-Total-Count, Link, X-Supabase-Api-Version"
		-Server
	}

	# Auth API
	handle_path /auth/v1/* {
		@options {
			method OPTIONS
		}
		respond @options 204

		reverse_proxy auth:9999
	}

	# REST API
	handle_path /rest/v1/* {
		@options {
			method OPTIONS
		}
		respond @options 204

		reverse_proxy rest:3000
	}

	# Web UI
	handle {
		reverse_proxy web:80
	}
}
